# Example environment variables for z-ecoimpact
# Copy to .env and update values before starting the app

# Server
PORT=3000

# MySQL (used when USE_MYSQL=true)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=admin
DB_DATABASE=z_ecoimpact

# Enable MySQL-backed storage for products/purchases/contacts
USE_MYSQL=true

# Gmail mailbox used by the server to authenticate SMTP delivery.
MAIL_USER=zecoimpactconsulting@gmail.com

# Create this in the Google account's security settings; do not use the normal password.
MAIL_APP_PASSWORD=THAYLAINE23@

# Optional destination for contact notifications; it defaults to the public Gmail address.
CONTACT_RECIPIENT=zecoimpactconsulting@gmail.com

# Example environment variables for z-ecoimpact
# Copy to .env and update values before starting the app

# Server
PORT=3000

# MySQL (used when USE_MYSQL=true)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_DATABASE=z_ecoimpact

# Enable MySQL-backed storage for products/purchases/contacts
USE_MYSQL=true
